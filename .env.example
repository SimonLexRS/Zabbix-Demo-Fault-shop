# Fault Shop: variables for Dokploy (Compose service -> Environment) or for .env with plain Docker.
# Only ZABBIX_URL, ZABBIX_API_TOKEN and OTEL_EXPORTER_OTLP_ENDPOINT are needed; the rest have defaults.

# ---------------------------------------------------------------- Zabbix (zabbix-bridge)
# Frontend URL (the bridge adds /api_jsonrpc.php). Zabbix 7.0 or newer.
ZABBIX_URL=https://zabbix.example.com
# API token of a Super admin user: Users -> API tokens -> Create API token.
ZABBIX_API_TOKEN=
# Host and host group the bridge creates.
ZABBIX_HOST=Fault Shop
ZABBIX_HOST_GROUP=Fault Shop
# Seconds between sends; LLD (service discovery) every ZABBIX_LLD_INTERVAL seconds.
ZABBIX_SEND_INTERVAL=10
ZABBIX_LLD_INTERVAL=600
# 1 = accept a self-signed certificate on ZABBIX_URL.
ZABBIX_TLS_INSECURE=0
# api = history.push over HTTPS (default, nothing else to open) | sender = Zabbix sender protocol, TCP 10051.
ZABBIX_TRANSPORT=api
ZABBIX_SERVER=
ZABBIX_PORT=10051
# 1 = create/update the dashboard "<ZABBIX_HOST> · Estado y APM".
ZABBIX_DASHBOARD=1
# APM host: linked to the OpenTelemetry template of Zabbix APM with {$OTLP.NAMESPACE}=OTEL_SERVICE_NAMESPACE.
# Skipped with a warning if that template does not exist in your Zabbix.
ZABBIX_APM_ENABLED=1
ZABBIX_APM_TEMPLATE=OpenTelemetry application by OTLP
ZABBIX_APM_HOST_NAME=apm-fault-shop
# 1 = only log what would be sent (testing).
ZABBIX_DRY_RUN=0

# ---------------------------------------------------------------- APM: OpenTelemetry -> ClickHouse
# A) Zabbix 8.0 proxy with APM collector (OTLP gRPC):   http://<proxy-apm>:4317   + PROTOCOL=grpc
# B) OpenTelemetry Collector with the clickhouse exporter (OTLP HTTP):  http://<collector>:4318 + PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Optional authentication headers, e.g. Authorization=Bearer%20xxxx (comma separated, URL-encoded values).
OTEL_EXPORTER_OTLP_HEADERS=
# Signals: traces and logs on by default; metrics off (set otlp if your receiver stores them).
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
# service.namespace = the "application" in Zabbix APM; also {$OTLP.NAMESPACE} of the APM host.
OTEL_SERVICE_NAMESPACE=fault-shop
DEPLOY_ENV=demo
# Browser telemetry (RUM): OTLP/HTTP receiver (port 4318) nginx forwards /otlp to. Must resolve when nginx starts.
RUM_OTLP_HTTP_ENDPOINT=http://host.docker.internal:4318

# ---------------------------------------------------------------- Store
# Defective release: 1.1.0 fails with KeyError on orders of 3 or more different products.
CHECKOUT_VERSION=1.0.0
# Plain Docker only (compose.local.yaml): published ports.
SHOP_PORT=18090
BRIDGE_PORT=18091
