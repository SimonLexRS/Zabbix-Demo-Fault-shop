# Fault Shop: variables for Dokploy (Compose service -> Environment) or for .env with plain Docker.
# Needed: ZABBIX_URL, ZABBIX_USER+ZABBIX_PASSWORD (or ZABBIX_API_TOKEN), OTEL_EXPORTER_OTLP_ENDPOINT and
# ZABBIX_CH_PASSWORD; the rest have defaults.

# ---------------------------------------------------------------- Zabbix (zabbix-bridge)
# Frontend URL (the bridge adds /api_jsonrpc.php). Zabbix 7.0 or newer.
ZABBIX_URL=https://zabbix.example.com
# Super admin credentials (Zabbix-Demo stack: Admin and its ZBX_ADMIN_PASSWORD, in single quotes)...
ZABBIX_USER=Admin
ZABBIX_PASSWORD=
# ...or the API token of a Super admin user (Users -> API tokens); it wins over user/password.
ZABBIX_API_TOKEN=
# Host and host group the bridge creates.
ZABBIX_HOST=Fault Shop
ZABBIX_HOST_GROUP=Fault Shop
# Seconds between sends; LLD (service discovery) every ZABBIX_LLD_INTERVAL seconds.
ZABBIX_SEND_INTERVAL=10
ZABBIX_LLD_INTERVAL=600
# 1 = accept a self-signed certificate on ZABBIX_URL.
ZABBIX_TLS_INSECURE=0
# api = history.push over HTTPS (default, nothing else to open) | sender = Zabbix sender protocol, TCP 10051.
ZABBIX_TRANSPORT=api
ZABBIX_SERVER=
ZABBIX_PORT=10051
# 1 = create/update the dashboard "<ZABBIX_HOST> · Estado y APM".
ZABBIX_DASHBOARD=1
# APM host: linked to the first OpenTelemetry template of the list that exists in your Zabbix, with its namespace
# macros set to OTEL_SERVICE_NAMESPACE. Skipped with a warning if none exists.
ZABBIX_APM_ENABLED=1
ZABBIX_APM_TEMPLATE=Generic OpenTelemetry by OTLP,OpenTelemetry application by OTLP
ZABBIX_APM_HOST_NAME=apm-fault-shop
# 1 = only log what would be sent (testing).
ZABBIX_DRY_RUN=0
# Business KPIs (APM-Dashboard module): template "APM business metrics by ClickHouse HTTP" on the APM host.
# ClickHouse as the Zabbix SERVER sees it (Zabbix Demo stack: http://clickhouse:8123/ and its CLICKHOUSE_USER/PASSWORD).
# Without ZABBIX_CH_PASSWORD the KPI items fail with "Authentication failed".
ZABBIX_KPI_ENABLED=1
ZABBIX_KPI_TIMEZONE=UTC
ZABBIX_KPI_METRIC_MATCHES=^shop\.
ZABBIX_CH_URL=http://clickhouse:8123/
ZABBIX_CH_DB=zabbix
ZABBIX_CH_USER=zabbix
# Stored in Zabbix as a secret macro ({$CH.PASSWORD}).
ZABBIX_CH_PASSWORD=

# ---------------------------------------------------------------- APM: OpenTelemetry -> ClickHouse
# Zabbix Demo stack (Dokploy): the receiver is the service "zabbix-proxy-apm", OTLP gRPC only, published on port 4317
# of the VPS. It is another Compose stack (another network), so use the host port, not the container name:
#   same server:   http://host.docker.internal:<OTLP_PORT of that Zabbix stack>   (4317, 4327... one per stack:
#                  with several Zabbix stacks on the VPS the port decides which one receives the telemetry)
#   other server:  http://<ip-del-vps>:4317   (open 4317/tcp)
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Optional authentication headers, e.g. Authorization=Bearer%20xxxx (comma separated, URL-encoded values).
OTEL_EXPORTER_OTLP_HEADERS=
# Signals: traces, logs and metrics (metrics feed the Business KPIs).
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=60000
# service.namespace = the "application" in Zabbix APM; also the namespace macro of the APM host.
OTEL_SERVICE_NAMESPACE=fault-shop
DEPLOY_ENV=demo
# Browser telemetry (RUM): nginx -> the internal otel-collector (OTLP/HTTP) -> gRPC to APM_GRPC_ENDPOINT.
RUM_OTLP_HTTP_ENDPOINT=http://otel-collector:4318
# Where the internal collector relays RUM (gRPC). Empty = OTEL_EXPORTER_OTLP_ENDPOINT.
APM_GRPC_ENDPOINT=
APM_TLS_INSECURE=true

# ---------------------------------------------------------------- Store
# Defective release: 1.1.0 fails with KeyError on orders of 3 or more different products.
CHECKOUT_VERSION=1.0.0
# Plain Docker only (compose.local.yaml): published ports.
SHOP_PORT=18090
BRIDGE_PORT=18091
